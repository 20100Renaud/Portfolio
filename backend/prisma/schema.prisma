generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum Type_Depo {
  OFFER
  REQUEST
  QUESTION
}

model T_Users {
  ID_User        String       @id @default(uuid())
  Role_User      String       @default("CLIENT")
  Login_User     String       @unique
  Email_Encrypted_User  String
  Email_Hash_User       String   @unique
  Password_User  String
  Date_User      DateTime     @default(now())
  City_User      String
  Latitude_User  Float
  Longitude_User Float

  Answers_User   T_Answers[]
  Depos_User     T_Depos[]
}

model T_Depos {
  ID_Depo          String       @id @default(uuid())
  ID_User          String
  Type_Depo        String       @default("OFFER")
  Cat_Depo         String       @default("Undefined")
  Title_Depo       String
  Text_Depo        String
  Date_Depo        DateTime     @default(now())
  Lifetime_Depo    DateTime     @default(now())


  Answers_Depos    T_Answers[]
  Images_Depos     T_Images[]
  User_Depos       T_Users      @relation(fields: [ID_User], references: [ID_User])
}

model T_Answers {
  ID_Answer      String    @id @default(uuid())
  ID_Depo        String
  ID_User        String
  Text_Answer    String
  Date_Answer    DateTime  @default(now())


  User_Answers   T_Users   @relation(fields: [ID_User], references: [ID_User])
  Depos_Answers  T_Depos   @relation(fields: [ID_Depo], references: [ID_Depo], onDelete: Cascade)
}

model T_Images {
  ID_Image       String    @id @default(uuid())
  ID_Depo        String
  URL_Image      String
  Text_Image     String?
  Date_Image     DateTime  @default(now())

  Depos_Images   T_Depos   @relation(fields: [ID_Depo], references: [ID_Depo], onDelete: Cascade)
}