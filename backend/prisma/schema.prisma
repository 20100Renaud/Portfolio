generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model T_Users {
  ID_User        String       @id @default(uuid())
  Login_User     String       @unique
  Mail_User      String       @unique
  Password_User  String
  Ville_User     String?
  Latitude_User  Float?
  Longitude_User Float?
  Date_User      DateTime     @default(now())
  Role_User      String       @default("CLIENT")

  Answers_User  T_Answers[]
  Ads_User     T_Ads[]
}

model T_Ads {
  ID_Ad          String       @id @default(uuid())
  Title_Ad       String
  Text_Ad        String
  Date_Ad        DateTime     @default(now())
  ID_User_Ad     String

  Answers_Ads    T_Answers[]
  User_Ads     T_Users    @relation(fields: [ID_User_Ad], references: [ID_User])
}

model T_Answers {
  ID_Answer      String    @id @default(uuid())
  Text_Answer    String
  Date_Answer        DateTime  @default(now())
  ID_Ad_Ans     String
  ID_User_Ans   String

  User_Answers T_Users @relation(fields: [ID_User_Ans], references: [ID_User])
  Ads_Answers   T_Ads   @relation(fields: [ID_Ad_Ans], references: [ID_Ad])
}
