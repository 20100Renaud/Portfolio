generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum Type_Depot {
  Depot
  Question
}

model T_Users {
  ID_User        String       @id @default(uuid())
  Login_User     String       @unique
  Mail_User      String       @unique
  Password_User  String
  Ville_User     String?
  Latitude_User  Float?
  Longitude_User Float?
  Date_User      DateTime     @default(now())
  Role_User      String       @default("CLIENT")

  Answers_User  T_Answers[]
  Depots_User     T_Depots[]
}

model T_Depots {
  ID_Depot          String       @id @default(uuid())
  Type_Depot        String       @default("Depot")
  Title_Depot       String
  Text_Depot        String
  Date_Depot        DateTime     @default(now())
  ID_User_Depot     String

  Answers_Depots    T_Answers[]
  User_Depots     T_Users    @relation(fields: [ID_User_Depot], references: [ID_User])
}

model T_Answers {
  ID_Answer      String    @id @default(uuid())
  Text_Answer    String
  Date_Answer        DateTime  @default(now())
  ID_Depot_Ans     String
  ID_User_Ans   String

  User_Answers T_Users @relation(fields: [ID_User_Ans], references: [ID_User])
  Depots_Answers   T_Depots   @relation(fields: [ID_Depot_Ans], references: [ID_Depot])
}
