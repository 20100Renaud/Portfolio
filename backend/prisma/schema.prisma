generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model T_Clients {
  ID_Client        String       @id @default(uuid())
  Login_Client     String       @unique
  Mail_Client      String       @unique
  Password_Client  String
  Ville_Client     String?
  Latitude_Client  Float?
  Longitude_Client Float?
  Date_Client      DateTime     @default(now())
  Role_Client      String       @default("CLIENT")

  Answers_Client  T_Answers[]
  Ads_Client     T_Ads[]
}

model T_Ads {
  ID_Ad          String       @id @default(uuid())
  Title_Ad       String
  Text_Ad        String
  Date_Ad        DateTime     @default(now())
  ID_Client_Ad   String

  Answers_Ads    T_Answers[]
  Client_Ads     T_Clients    @relation(fields: [ID_Client_Ad], references: [ID_Client])
}

model T_Answers {
  ID_Answer      String    @id @default(uuid())
  Text_Answer    String
  Date_Answer        DateTime  @default(now())
  ID_Ad_Ans     String
  ID_Client_Ans   String

  Client_Answers T_Clients @relation(fields: [ID_Client_Ans], references: [ID_Client])
  Ads_Answers   T_Ads   @relation(fields: [ID_Ad_Ans], references: [ID_Ad])
}
