generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  ID_Client      String    @id @default(uuid())
  Login_Client   String    @unique
  Mail_Client    String    @unique
  Password_Client String
  Date_Client    DateTime  @default(now())

  posts          Post[]
  comments       Comment[]
}

model Post {
  ID_Post        String   @id @default(uuid())
  Title_Post     String
  Description_Post String
  Date_Post      DateTime @default(now())

  ID_Client_Post String
  client         Client   @relation(fields: [ID_Client_Post], references: [ID_Client])

  comments       Comment[]
}

model Comment {
  ID_Com         String   @id @default(uuid())
  Description_Com String
  Date_Com       DateTime @default(now())

  ID_Post        String
  post           Post     @relation(fields: [ID_Post], references: [ID_Post])

  ID_Client_Com  String
  client         Client   @relation(fields: [ID_Client_Com], references: [ID_Client])
}
